# משתני סביבה ל-Edge Functions (הגדירו ב-Supabase: Functions > Secrets)
# supabase secrets set --env-file supabase/functions/.env.example

# בחירת רשת השותפים
AFFILIATE_NETWORK=admitad

# פרטי Admitad (https://www.admitad.com/ -> Tools -> API)
ADMITAD_CLIENT_ID=
ADMITAD_CLIENT_SECRET=
ADMITAD_WEBSITE_ID=
ADMITAD_SCOPE=advcampaigns_for_website

# סוד ל-postback (יופיע ב-URL שמגדירים ברשת) ולסנכרון החנויות
POSTBACK_SECRET=
SYNC_SECRET=

# מוזרקים אוטומטית ע"י Supabase לפונקציות — לא צריך להגדיר ידנית:
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
